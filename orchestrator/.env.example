# LinuxLab orchestrator configuration
# Copy to .env and fill in real values.

# Port the orchestrator listens on
PORT=8080

# Shared secret used by the backend to authenticate. Generate with:
#   openssl rand -hex 32
ORCHESTRATOR_TOKEN=change-me-to-a-long-random-string

# Default Docker image for student containers
LAB_IMAGE=linuxlab:latest

# Default resource limits
CONTAINER_MEM_MB=512
CONTAINER_CPU=0.5
CONTAINER_PIDS=256

# Default lifecycle (minutes). Containers with no activity for SESSION_TTL
# minutes, or older than MAX_LIFE, are destroyed by the sweeper.
SESSION_TTL_MINUTES=60
MAX_LIFE_MINUTES=180

# Hard cap on concurrent student containers per VPS
MAX_CONTAINERS=20
