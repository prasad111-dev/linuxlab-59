# LinuxLab backend environment — copy to .env and fill in real values.

NODE_ENV=development
PORT=4000

# MongoDB Atlas M0 connection string (create free cluster, allow 0.0.0.0/0)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.mongodb.net/linuxlab?retryWrites=true&w=majority

# JWT signing secret — generate with: openssl rand -hex 32
JWT_SECRET=change-me

# Google OAuth 2.0 (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback

# Frontend origin (used for the OAuth callback redirect and CORS)
FRONTEND_URL=http://localhost:5173

# Lab VPS orchestrator
ORCHESTRATOR_URL=http://localhost:8080
ORCHESTRATOR_WS_URL=ws://localhost:8080
ORCHESTRATOR_TOKEN=change-me-to-a-long-random-string

# Gemini API (free tier) — optional; AI features degrade gracefully without it
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Comma-separated Google emails that receive the admin role on login
ADMIN_EMAILS=

# Lab session lifecycle (minutes) + container resources
SESSION_TTL_MINUTES=60
CONTAINER_MEM_MB=512
CONTAINER_CPU=0.5
CONTAINER_PIDS=256

# Evaluation: pass mark for a task (%)
PASS_MARK=70
